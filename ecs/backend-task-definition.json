{
    "family": "skillpulse-prod-backend-task",
    "containerDefinitions": [
        {
            "name": "skillpulse-backend-container",
            "image": "IMAGE_PLACEHOLDER",
            "portMappings": [
                {
                    "containerPort": 8080,
                    "hostPort": 8080,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                {
                    "name": "PORT",
                    "value": "8080"
                }
            ],
            "secrets": [
                {
                    "name": "DB_PORT",
                    "valueFrom": "arn:aws:secretsmanager:ap-south-2:335357805095:secret:skillpulse/db:DB_PORT::"
                },
                {
                    "name": "DB_USER",
                    "valueFrom": "arn:aws:secretsmanager:ap-south-2:335357805095:secret:skillpulse/db:DB_USER::"
                },
                {
                    "name": "DB_NAME",
                    "valueFrom": "arn:aws:secretsmanager:ap-south-2:335357805095:secret:skillpulse/db:DB_NAME::"
                },
                {
                    "name": "DB_HOST",
                    "valueFrom": "arn:aws:secretsmanager:ap-south-2:335357805095:secret:skillpulse/db:DB_HOST::"
                },
                {
                    "name": "DB_PASSWORD",
                    "valueFrom": "arn:aws:secretsmanager:ap-south-2:335357805095:secret:skillpulse/db:DB_PASSWORD::"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/skillpulse-prod-backend-task",
                    "awslogs-create-group": "true",
                    "awslogs-region": "ap-south-2",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ],
    "executionRoleArn": "arn:aws:iam::335357805095:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "2048",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    }
}